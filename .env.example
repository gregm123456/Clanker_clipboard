# Copy this to .env and fill in device-specific values.
# Never commit .env to GitHub.

# Optional: hostname or IP of the Clanker system hub (for pushing state)
# CLANKER_HUB_HOST=clanker-pi5.tailnet-name.ts.net
# CLANKER_HUB_PORT=8765

# HTTP port this service listens on for state queries (default: 8080)
# CLIPBOARD_HTTP_PORT=8080

# ADC SPI bus and chip-select for MCP3008 (picker wiring uses CE1 for ADC)
# MCP3008_SPI_BUS=0
# MCP3008_SPI_DEVICE=1

# ePaper SPI configuration (picker wiring uses CE0 for the IT8951 display)
# EPAPER_SPI_BUS=0
# EPAPER_SPI_DEVICE=0
# EPAPER_SPI_HZ=24000000
# EPAPER_VCOM=-2.06
